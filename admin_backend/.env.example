APP_ENV=development
PORT=3005
ADMIN_JSON_BODY_LIMIT=2mb
PROVIDER_HTTP_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=1
PUBLIC_ADMIN_WEB_ORIGIN=http://localhost:5174
PUBLIC_ADMIN_WEB_ORIGINS=http://localhost:5174
HEALTHCHECK_REQUIRE_MYSQL=true
LOG_LEVEL=info
REQUEST_LOGGING_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SESSION_COOKIE_NAME=global_lmg_admin_session
CSRF_COOKIE_NAME=global_lmg_admin_csrf
AUTH_SESSION_SECRET=change-this-admin-development-session-secret-now
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
MAX_ACTIVE_SESSIONS_PER_USER=10
OBJECT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_ROOT=../storage/glmg-uploads
DOCUMENT_UPLOAD_MAX_BYTES=26214400
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_VERIFY_UPLOAD_SHA256=true
FILE_SCAN_MODE=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
FILE_SCAN_BLOCK_PREVIEW_UNTIL_CLEAN=true
FILE_SCAN_BLOCK_DOWNLOAD_UNTIL_CLEAN=false

# Provider delivery stays in-app/local unless these modes and credentials are explicitly configured.
EMAIL_PROVIDER_MODE=disabled
EMAIL_FROM_ADDRESS=Global LMG <no-reply@example.com>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_IP_ALLOWLIST=
SMS_PROVIDER_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_WEBHOOK_IP_ALLOWLIST=
PROVIDER_TEST_EMAIL=
PROVIDER_TEST_PHONE=
REMINDER_PROCESS_BATCH_SIZE=100
FX_PROVIDER_MODE=api
FX_BASE_CURRENCY=USD
FX_DEFAULT_FALLBACK_POLICY=fail_closed
FX_PROVIDER_URL_TEMPLATE=

# Calendar sync is local/manual unless explicitly integrated.
CALENDAR_SYNC_MODE=disabled
CALENDAR_ADMIN_AUTH_MODE=workspace_delegation
CALENDAR_CLIENT_INVITE_MODE=google_attendee
APP_SEND_EVENT_EMAIL=false
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=primary
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_IMPERSONATE_DOMAIN=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_SEND_UPDATES=all

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=global_lmg
MYSQL_USER=global_lmg_admin_app
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=100
MYSQL_WAIT_FOR_CONNECTIONS=true
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_SSL_MODE=DISABLED
MYSQL_SSL_CA_PATH=
MYSQL_SSL_CA=

# Local first-admin bootstrap. Keep password only in your ignored local .env.
# In production, ADMIN_BOOTSTRAP_ENABLED=true is required even when running the explicit script.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@example.local
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Global LMG Admin
# First-admin bootstrap should normally use ops_admin.
# Seeded operational roles also include case_manager, billing_admin, billing_staff, case_staff, and advocate.
# Custom ADMIN_BOOTSTRAP_ROLE values are allowed only after that role exists.
ADMIN_BOOTSTRAP_ROLE=ops_admin
ADMIN_BOOTSTRAP_FORCE_ROTATION=true
ADMIN_BOOTSTRAP_RESET_PASSWORD=false
