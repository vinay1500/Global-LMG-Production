APP_ENV=production
LOG_LEVEL=info
REQUEST_LOGGING_ENABLED=true
SENTRY_DSN=<sentry-admin-api-dsn>
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=<git-sha-or-release-version>
SENTRY_TRACES_SAMPLE_RATE=0.05
PORT=3005
ADMIN_JSON_BODY_LIMIT=2mb
PROVIDER_HTTP_TIMEOUT_MS=10000
PUBLIC_ADMIN_WEB_ORIGIN=https://admin.globallmg.org
HEALTHCHECK_REQUIRE_MYSQL=true

SESSION_COOKIE_NAME=global_lmg_admin_session
CSRF_COOKIE_NAME=global_lmg_admin_csrf
AUTH_SESSION_SECRET=<generate-different-strong-48-byte-base64url-secret>
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
MAX_ACTIVE_SESSIONS_PER_USER=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_IP_MAX_ATTEMPTS=20
AUTH_RATE_LIMIT_LOCK_MINUTES=10

MYSQL_HOST=<aiven-mysql-host>
MYSQL_PORT=3306
MYSQL_DATABASE=defaultdb
MYSQL_USER=<aiven-admin-app-user>
MYSQL_PASSWORD=<aiven-admin-app-password>
MYSQL_CONNECTION_LIMIT=20
MYSQL_QUEUE_LIMIT=100
MYSQL_WAIT_FOR_CONNECTIONS=true
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_SSL_MODE=REQUIRED
MYSQL_SSL_CA_PATH=/etc/global-lmg/aiven-ca.pem

EMAIL_PROVIDER_MODE=resend
EMAIL_FROM_ADDRESS=Global LMG <no-reply@globallmg.org>
RESEND_API_KEY=<resend-api-key>
RESEND_WEBHOOK_SECRET=<resend-webhook-secret>
RESEND_WEBHOOK_IP_ALLOWLIST=

SMS_PROVIDER_MODE=twilio
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_FROM_NUMBER=<twilio-e164-from-number>
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=<twilio-verify-service-sid-if-needed>
TWILIO_WEBHOOK_AUTH_TOKEN=<twilio-webhook-auth-token>
TWILIO_WEBHOOK_IP_ALLOWLIST=
WEBHOOK_PUBLIC_BASE_URL=https://admin-api.globallmg.org

REMINDER_PROCESS_BATCH_SIZE=25
FX_PROVIDER_MODE=api
FX_BASE_CURRENCY=USD
FX_DEFAULT_FALLBACK_POLICY=fail_closed
FX_PROVIDER_URL_TEMPLATE=

CALENDAR_SYNC_MODE=disabled
CALENDAR_ADMIN_AUTH_MODE=workspace_delegation
CALENDAR_CLIENT_INVITE_MODE=google_attendee
APP_SEND_EVENT_EMAIL=false
GOOGLE_CALENDAR_DEFAULT_CALENDAR_ID=primary
GOOGLE_CALENDAR_IMPERSONATE_DOMAIN=globallmg.org
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_SEND_UPDATES=all

OBJECT_STORAGE_DRIVER=s3
DOCUMENT_STORAGE_DRIVER=s3
S3_ENDPOINT=<s3-compatible-endpoint>
S3_REGION=auto
S3_BUCKET=<private-documents-bucket>
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
S3_SESSION_TOKEN=
S3_VERIFY_UPLOAD_SHA256=true

FILE_SCAN_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
FILE_SCAN_PENDING_TIMEOUT_MINUTES=5
FILE_SCAN_BLOCK_DOWNLOAD_UNTIL_CLEAN=true
FILE_SCAN_BLOCK_PREVIEW_UNTIL_CLEAN=true

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Global LMG Admin
ADMIN_BOOTSTRAP_ROLE=ops_admin
ADMIN_BOOTSTRAP_FORCE_ROTATION=true
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

PROVIDER_TEST_EMAIL=<safe-provider-test-email>
PROVIDER_TEST_PHONE=<safe-provider-test-phone-e164>
