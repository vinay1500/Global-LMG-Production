APP_ENV=production
LOG_LEVEL=info
REQUEST_LOGGING_ENABLED=true
SENTRY_DSN=<sentry-client-api-dsn>
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=<git-sha-or-release-version>
SENTRY_TRACES_SAMPLE_RATE=0.05
PORT=3001
API_JSON_BODY_LIMIT=1mb
PROVIDER_HTTP_TIMEOUT_MS=10000
PUBLIC_WEB_ORIGIN=https://app.globallmg.org
HEALTHCHECK_REQUIRE_MYSQL=true

SESSION_COOKIE_NAME=global_lmg_session
AUTH_FLOW_COOKIE_NAME=global_lmg_auth_flow
CSRF_COOKIE_NAME=global_lmg_csrf
AUTH_SESSION_SECRET=<generate-strong-48-byte-base64url-secret>
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
MAX_ACTIVE_SESSIONS_PER_USER=10
EMAIL_VERIFICATION_TTL_MINUTES=15
PHONE_OTP_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=15
AUTH_FLOW_TTL_MINUTES=30
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

MYSQL_HOST=<aiven-mysql-host>
MYSQL_PORT=3306
MYSQL_DATABASE=defaultdb
MYSQL_USER=<aiven-app-user>
MYSQL_PASSWORD=<aiven-app-password>
MYSQL_CONNECTION_LIMIT=20
MYSQL_QUEUE_LIMIT=100
MYSQL_WAIT_FOR_CONNECTIONS=true
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_SSL_MODE=REQUIRED
MYSQL_SSL_CA_PATH=/etc/global-lmg/aiven-ca.pem

EMAIL_PROVIDER_MODE=resend
EMAIL_FROM_ADDRESS=Global LMG <no-reply@globallmg.org>
RESEND_API_KEY=<resend-api-key>

SMS_PROVIDER_MODE=twilio-verify
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_VERIFY_SERVICE_SID=<twilio-verify-service-sid>
TWILIO_FROM_NUMBER=<twilio-e164-from-number-if-used>
TWILIO_MESSAGING_SERVICE_SID=

GOOGLE_AUTH_MODE=disabled
GOOGLE_CLIENT_ID=
ADDRESS_VALIDATION_MODE=disabled
GOOGLE_MAPS_API_KEY=
GOOGLE_ADDRESS_VALIDATION_API_KEY=
IP_GEOLOCATION_MODE=cloudflare
IP_GEOLOCATION_PROVIDER_API_KEY=
DEFAULT_PRICING_COUNTRY=US
DEFAULT_PRICING_CURRENCY=USD
FX_PROVIDER_MODE=api
FX_BASE_CURRENCY=USD
FX_DEFAULT_FALLBACK_POLICY=fail_closed
FX_PROVIDER_URL_TEMPLATE=

PAYMENT_PROVIDER_MODE=razorpay
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>
RAZORPAY_WEBHOOK_IP_ALLOWLIST=
RAZORPAY_CAPTURE_MODE=auto
RAZORPAY_ALLOWED_CURRENCIES=USD
REQUEST_PAYMENT_DRAFT_EXPIRY_MINUTES=30

OBJECT_STORAGE_DRIVER=s3
DOCUMENT_STORAGE_DRIVER=s3
S3_ENDPOINT=<s3-compatible-endpoint>
S3_REGION=auto
S3_BUCKET=<private-documents-bucket>
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
S3_SESSION_TOKEN=
S3_VERIFY_UPLOAD_SHA256=true

FILE_SCAN_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
FILE_SCAN_PENDING_TIMEOUT_MINUTES=5
FILE_SCAN_BLOCK_DOWNLOAD_UNTIL_CLEAN=true
FILE_SCAN_BLOCK_PREVIEW_UNTIL_CLEAN=true

PREVIEW_ACCOUNT_ENABLED=false
PROVIDER_TEST_EMAIL=<safe-provider-test-email>
PROVIDER_TEST_PHONE=<safe-provider-test-phone-e164>
