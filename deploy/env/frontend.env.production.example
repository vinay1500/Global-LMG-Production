VITE_PUBLIC_SITE_URL=https://app.globallmg.org
VITE_API_BASE_URL=https://api.globallmg.org/api/v1
VITE_API_TIMEOUT_MS=15000
VITE_API_DOWNLOAD_TIMEOUT_MS=60000
VITE_SENTRY_DSN=<sentry-public-frontend-dsn>
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=<git-sha-or-release-version>
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_GOOGLE_CLIENT_ID=<google-oauth-client-id>
VITE_GOOGLE_MAPS_API_KEY=
VITE_ADDRESS_AUTOCOMPLETE_MODE=disabled
# Paste final Google Forms URLs here when approved. Leave blank to show safe fallback copy.
VITE_GOOGLE_INTAKE_FORM_URL=
VITE_GOOGLE_CAREERS_FORM_URL=
VITE_GOOGLE_CONTACT_FORM_URL=
VITE_GOOGLE_PARTNER_FORM_URL=
