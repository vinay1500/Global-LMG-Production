APP_ENV=development
LOG_LEVEL=info
REQUEST_LOGGING_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
PORT=3001
API_JSON_BODY_LIMIT=1mb
PROVIDER_HTTP_TIMEOUT_MS=10000
PUBLIC_WEB_ORIGIN=http://localhost:5173
AUTH_STORE_MODE=mysql
DASHBOARD_STORE_MODE=mysql
HEALTHCHECK_REQUIRE_MYSQL=true
SESSION_COOKIE_NAME=global_lmg_session
AUTH_FLOW_COOKIE_NAME=global_lmg_auth_flow
CSRF_COOKIE_NAME=global_lmg_csrf
AUTH_SESSION_SECRET=change-this-development-session-secret-now
SESSION_TTL_HOURS=12
REMEMBER_ME_TTL_DAYS=30
MAX_ACTIVE_SESSIONS_PER_USER=10
EMAIL_VERIFICATION_TTL_MINUTES=15
PHONE_OTP_TTL_MINUTES=10
PASSWORD_RESET_TTL_MINUTES=15
AUTH_FLOW_TTL_MINUTES=30
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
EMAIL_PROVIDER_MODE=disabled
SMS_PROVIDER_MODE=disabled
GOOGLE_AUTH_MODE=disabled
# Ignored while EMAIL_PROVIDER_MODE=disabled. Set when EMAIL_PROVIDER_MODE=resend.
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VERIFY_SERVICE_SID=
GOOGLE_CLIENT_ID=
ADDRESS_VALIDATION_MODE=disabled
GOOGLE_MAPS_API_KEY=
GOOGLE_ADDRESS_VALIDATION_API_KEY=
IP_GEOLOCATION_MODE=disabled
IP_GEOLOCATION_PROVIDER_API_KEY=
DEFAULT_PRICING_COUNTRY=US
DEFAULT_PRICING_CURRENCY=USD
FX_PROVIDER_MODE=api
FX_BASE_CURRENCY=USD
FX_DEFAULT_FALLBACK_POLICY=fail_closed
FX_PROVIDER_URL_TEMPLATE=
PAYMENT_PROVIDER_MODE=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_IP_ALLOWLIST=
RAZORPAY_CAPTURE_MODE=auto
# SMS_PROVIDER_MODE=twilio uses Programmable Messaging for OTP codes.
# SMS_PROVIDER_MODE=twilio-verify uses Twilio Verify and requires TWILIO_VERIFY_SERVICE_SID.
# Optional compatibility alias: PHONE_PROVIDER_MODE=twilio
# Production Google mode should be: GOOGLE_AUTH_MODE=google-jwt
PREVIEW_ACCOUNT_ENABLED=false
PREVIEW_ACCOUNT_ID=user-1
PREVIEW_ACCOUNT_NAME=Arjun Mehta
PREVIEW_ACCOUNT_EMAIL=arjun.m@example.com
PREVIEW_ACCOUNT_PHONE=+91 98765 43210
PREVIEW_ACCOUNT_COUNTRY=IN
PREVIEW_ACCOUNT_PASSWORD=Preview@123
PREVIEW_GOOGLE_EMAIL=preview.google@globallmg.org
PREVIEW_GOOGLE_NAME=Google Preview Client
PREVIEW_GOOGLE_COUNTRY=IN
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=global_lmg
MYSQL_USER=global_lmg_app
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=100
MYSQL_WAIT_FOR_CONNECTIONS=true
MYSQL_CONNECT_TIMEOUT_MS=5000
MYSQL_SSL_MODE=DISABLED
MYSQL_SSL_CA_PATH=
MYSQL_SSL_CA=
OBJECT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_DRIVER=local
DOCUMENT_STORAGE_ROOT=../storage/glmg-uploads
DOCUMENT_UPLOAD_MAX_BYTES=26214400
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_VERIFY_UPLOAD_SHA256=true
FILE_SCAN_MODE=disabled
CLAMAV_HOST=
CLAMAV_PORT=3310
FILE_SCAN_BLOCK_PREVIEW_UNTIL_CLEAN=true
FILE_SCAN_BLOCK_DOWNLOAD_UNTIL_CLEAN=false
SHUTDOWN_TIMEOUT_MS=15000
PROVIDER_TEST_EMAIL=
PROVIDER_TEST_PHONE=
